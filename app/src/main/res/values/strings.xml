    <string name="st_written_label">Written</string>
    <string name="st_interrupted">(stopped)</string>
    <string name="st_write_error">Error while writing: %1$s</string>
    <string name="st_free_drop_label">Free space decrease</string>
    <string name="st_free_drop_value">Wrote %1$s, but free space decreased by only %2$s</string>
    <string name="st_free_drop_note">The written data may not have been saved. However, when free space decreases the system deletes other apps\' caches, so this can also happen on normal devices. Judge by whether there is corrupted data.</string>
    <string name="st_verified_label">Verified OK</string>
    <string name="st_verify_interrupted">(verification stopped)</string>
    <string name="st_bad_label">Corrupted data</string>
    <string name="st_bad_value">%1$s (first corruption around %2$s)</string>
    <string name="st_bad_note">The written data could not be read back correctly. This strongly suggests \"capacity faking\" (displayed capacity larger than the real one) or a storage failure. The first corruption position is a rough guide to the real writable capacity.</string>
    <string name="st_partial_note">No problems in the range tested so far. Run to the end to check the full capacity.</string>
    <string name="st_all_ok_note">All %1$s written was saved correctly.</string>
