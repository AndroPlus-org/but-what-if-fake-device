    <string name="bat_section">Battery</string>
    <string name="bat_level_label">Level</string>
    <string name="bat_design_label">Design capacity (power profile)</string>
    <string name="bat_design_kernel_label">Design capacity (kernel)</string>
    <string name="bat_full_label">Full charge capacity (kernel, reflects wear)</string>
    <string name="bat_est_label">Estimated full capacity (from remaining charge)</string>
    <string name="bat_est_value">%1$s mAh (now %2$s mAh)</string>
    <string name="bat_est_note">The higher the charge level, the more accurate. A rough guide that depends on the accuracy of the battery fuel gauge.</string>
    <string name="bat_est_low" formatted="false">Can be calculated at 20% charge or higher</string>
    <string name="bat_est_bad">Cannot calculate (the device reports an inaccurate remaining charge)</string>
    <string name="bat_est_none">This device does not report the remaining charge</string>
    <string name="bat_ratio_label">Actual vs. design capacity</string>
    <string name="bat_ratio_note">The capacity that can actually be stored is far below the design value. Either the capacity is inflated or the battery is worn. Devices with two cells (such as foldables) may report only one cell and show about half.</string>
    <string name="bat_howto_value">Compare with the battery capacity (mAh) on the spec sheet.</string>
    <string name="bat_howto_note">Manufacturers can set the design capacity freely, so the estimated full capacity and kernel values are closer to reality.</string>
    <string name="bat_cycles_label">Charge cycles</string>
