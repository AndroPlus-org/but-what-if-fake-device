    <string name="mem_section">Memory (RAM)</string>
    <string name="mem_kernel_label">Physical RAM (kernel /proc/meminfo)</string>
    <string name="mem_kernel_value">"%1$s  → nominal %2$s"</string>
    <string name="mem_kernel_note">MemTotal is normally shown a few percent below the nominal value.</string>
    <string name="mem_api_label">Physical RAM (Android API)</string>
    <string name="mem_match_label">Kernel vs. API value</string>
    <string name="mem_mismatch">Mismatch (%1$s%% difference)</string>
    <string name="mem_mismatch_note">The RAM size returned by the Android framework differs from the kernel value. This is a typical trace of a modified framework inflating the RAM size.</string>
    <string name="mem_avail_label">Currently free RAM</string>
    <string name="mem_swap_label">Virtual RAM / RAM extension (swap)</string>
    <string name="mem_swap_value">%1$s (in use %2$s)</string>
    <string name="mem_swap_note">Virtual memory using storage or compressed memory (zram), not physical RAM. If the device is advertised with the physical + virtual total, such as \"RAM %1$s\", the actual physical RAM is %2$s.</string>
    <string name="mem_props_label">Capacity-related system properties</string>
    <string name="mem_props_note">The capacity shown in Settings may be built from these values. Check for values that differ greatly from the physical ones.</string>
    <string name="mem_test_label">Real-world test</string>
    <string name="mem_test_value">Use \"RAM test\" above to actually allocate memory and check</string>
    <string name="sto_section">Storage</string>
    <string name="sto_data_label">Data partition (/data, statfs)</string>
    <string name="sto_data_value">Total %1$s / Free %2$s</string>
    <string name="sto_data_note">The area available to the user. It excludes the OS area, so it is smaller than the nominal capacity.</string>
    <string name="sto_adv_label">Internal storage capacity (shown in Settings)</string>
    <string name="sto_adv_note">The nominal capacity Android shows in Settings (rounded to a power of 2).</string>
    <string name="sto_ratio_label">Nominal capacity / data partition ratio</string>
    <string name="sto_ratio_value">%1$s×</string>
    <string name="sto_ratio_note">Usually about 1.1–2.0× (the difference is the OS area). If it is extremely large, only the displayed capacity may have been inflated.</string>
    <string name="sto_dev_label">Physical storage devices (kernel)</string>
    <string name="sto_phys_label">Nominal vs. physical device capacity</string>
    <string name="sto_phys_bad">Nominal %1$s &gt; physical %2$s</string>
    <string name="sto_phys_bad_note">A capacity larger than the physical device is shown. Capacity faking is likely.</string>
    <string name="sto_dev_unreadable">Unreadable (restricted on newer Android versions)</string>
    <string name="sto_write_label">Write test</string>
    <string name="sto_write_value">Use \"Storage write test\" above to actually write data to the free space and read it back. Fake capacity is detected as corrupted data.</string>
    <string name="disp_section">Display</string>
    <string name="disp_render_label">Rendering resolution</string>
    <string name="disp_render_note">The number of pixels apps actually render.</string>
    <string name="disp_panel_label">Panel resolution (display mode)</string>
    <string name="disp_diff_label">Resolution difference</string>
    <string name="disp_diff_value">Rendering %1$s ≠ panel %2$s</string>
    <string name="disp_diff_note">Rendering at a lower resolution because of the \"Screen resolution\" setting or automatic resolution switching for power saving. This is standard behavior on many devices, not faking. Set the highest resolution before doing the visual test.</string>
    <string name="disp_modes_label">Supported display modes</string>
    <string name="disp_maxhz_label">Max refresh rate (reported)</string>
    <string name="disp_maxhz_note">Use \"Measure refresh rate\" above to measure the actual rendering fps.</string>
    <string name="disp_hz_label">Refresh rate (reported)</string>
    <string name="disp_size_label">Screen size (calculated from dpi)</string>
    <string name="disp_size_value">%1$s in / %2$s ppi (xdpi=%3$s, ydpi=%4$s)</string>
    <string name="disp_size_note_ok">Compare with the screen diagonal measured with a ruler. If it differs greatly, the vendor-set value is inaccurate.</string>
    <string name="disp_size_note_bad">This device does not set its dpi values correctly, so the screen size cannot be calculated (not necessarily faking).</string>
    <string name="disp_density_label">Logical density</string>
    <string name="disp_hdr_label">HDR support</string>
    <string name="disp_wcg_label">Wide Color Gamut</string>
    <string name="disp_visual_label">Visual test</string>
    <string name="disp_visual_value">Use \"Display test\" to check 1-pixel stripes, gradients, solid colors and multi-touch.</string>
    <string name="disp_visual_note">Magnify the 1px stripes with a phone camera or similar. If the stripes do not look clean and appear gray or as moiré, the actual panel resolution may be lower than reported (downscaled).</string>
    <string name="soc_section" translatable="false">CPU / SoC / GPU</string>
